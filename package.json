{
  "name": "gesturecanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local camera studio for desktop and browser",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-web.mjs",
    "dev": "npm run build && node tools/serve-web.mjs",
    "test": "node --test tests/web/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:demo": "npm run build && node tools/serve-web.mjs --demo --port 4174",
    "test:backend:live": "node tools/test-backend-live.mjs",
    "db:migrate": "node tools/supabase-db.mjs migrate",
    "db:test": "node tools/supabase-db.mjs test && node tools/supabase-db.mjs test-counts",
    "retention:check": "node tools/setup-retention.mjs check",
    "audit:repository": "node tools/audit-repository.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/supabase-js": "^2.118.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pg": "^8.23.1"
  }
}
