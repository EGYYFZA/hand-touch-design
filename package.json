{
  "name": "egz-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A gesture-controlled camera playground for browser and desktop",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-web.mjs",
    "tutorials:render": "node tools/tutorial-video/render.mjs",
    "home:poster": "node tools/render-home-poster.mjs",
    "dev": "npm run build && node tools/serve-web.mjs",
    "test": "node --test tests/web/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:demo": "npm run build && node tools/serve-web.mjs --demo --port 4174",
    "audit:repository": "node tools/audit-repository.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/supabase-js": "^2.118.0",
    "sharp": "^0.35.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pg": "^8.23.1"
  }
}
